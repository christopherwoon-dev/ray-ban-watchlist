# Copy this file to .env.local (already git-ignored) and fill in the real
# values from Vercel → your project → Settings → Environment Variables, so
# devserver.py can reach the same Upstash Redis store as production.
#
# Only these two are needed (the REST API pair, not the redis:// ones).

KV_REST_API_URL=
KV_REST_API_TOKEN=
